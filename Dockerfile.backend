# Backend-only Dockerfile (frontend already built into static/)
FROM maven:3.8.5-openjdk-17 AS backend-builder
WORKDIR /app
COPY pom.xml .
RUN mvn dependency:go-offline
COPY src ./src
RUN mvn clean package -DskipTests

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

# Install Playwright system dependencies
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libdbus-1-3 libxkbcommon0 libatspi2.0-0 libxcomposite1 libxdamage1 \
    libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 \
    libwayland-client0 wget unzip fonts-liberation libappindicator3-1 \
    xdg-utils libgtk-3-0 libgdk-pixbuf2.0-0 libpangocairo-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Download and install Chromium for Playwright
RUN wget -q https://playwright.azureedge.net/builds/chromium/1155/chromium-linux.zip -O /tmp/chromium.zip \
    && mkdir -p /ms-playwright/chromium-1155 \
    && unzip -q /tmp/chromium.zip -d /ms-playwright/chromium-1155 \
    && rm /tmp/chromium.zip \
    && chmod +x /ms-playwright/chromium-1155/chrome-linux/chrome

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY --from=backend-builder /app/target/app.jar app.jar
EXPOSE 8085
CMD ["java", "-jar", "app.jar"]
